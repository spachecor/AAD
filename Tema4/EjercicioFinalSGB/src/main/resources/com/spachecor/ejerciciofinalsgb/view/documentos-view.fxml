<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #DDD0C8;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.spachecor.ejerciciofinalsgb.controller.DocumentosController">
   <children>
      <VBox alignment="CENTER" prefHeight="720.0" prefWidth="440.0" spacing="25.0">
         <children>
            <Label text="Gestión de los documentos" textFill="#323232">
               <font>
                  <Font name="Times New Roman Bold" size="36.0" />
               </font></Label>
            <Label text="AVISO: No se deben modificar las rutas con intención de modificar las &#10;categorías. Para eso ya está la sección de Colecciones o la sección de &#10;libros. Si se intentan manejar desde aquí podría haber modificaciones &#10;importantes en las rutas que hagan que la aplicación no funcione bien. &#10;Recomendamos un uso responsable de esta sección.">
               <font>
                  <Font name="Times New Roman Bold" size="13.0" />
               </font>
            </Label>
            <VBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="Colección" textFill="#323232">
                           <font>
                              <Font name="Times New Roman Bold" size="18.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="100.0" />
                           </HBox.margin>
                        </Label>
                        <Label text="Subcolección" textFill="#323232">
                           <font>
                              <Font name="Times New Roman Bold" size="18.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="85.0" />
                           </HBox.margin>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="25.0">
                     <children>
                        <ChoiceBox fx:id="coleccionChoiceBox" prefWidth="150.0" />
                        <TextField fx:id="subColeccionTextField" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#onClickAniadirButton" style="-fx-background-color: #323232;" text="Añadir&#10;(Desde documento XML)" textAlignment="CENTER" textFill="#ddd0c8">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Button>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="25.0">
               <children>
                  <TextField fx:id="modificarTextField" promptText="Nueva ruta interna">
                     <font>
                        <Font name="Times New Roman" size="18.0" />
                     </font></TextField>
                  <Button mnemonicParsing="false" onAction="#onClickModificarButton" style="-fx-background-color: #323232;" text="Modificar" textAlignment="CENTER" textFill="#ddd0c8">
                     <font>
                        <Font name="Times New Roman Bold" size="24.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>
            <Button mnemonicParsing="false" onAction="#onClickEliminarButton" style="-fx-background-color: #323232;" text="Eliminar" textAlignment="CENTER" textFill="#ddd0c8">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Button>
            <Button mnemonicParsing="false" onAction="#onClickExportarButton" style="-fx-background-color: #323232;" text="Exportar" textAlignment="CENTER" textFill="#ddd0c8">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Button>
            <Button layoutX="173.0" layoutY="629.0" mnemonicParsing="false" onAction="#onClickSalirButton" style="-fx-background-color: #323232;" text="Salir" textAlignment="CENTER" textFill="#ddd0c8">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Button>
         </children></VBox>
      <VBox prefHeight="720.0" prefWidth="840.0">
         <children>
            <TableView fx:id="documentosTableView" onMouseClicked="#onClickDocumentosTableView" prefHeight="720.0" prefWidth="840.0">
              <columns>
                <TableColumn fx:id="documentosTableColumn" maxWidth="825.0" minWidth="100.0" prefWidth="825.0" text="Rutas internas" />
              </columns>
            </TableView>
         </children></VBox>
   </children>
</HBox>
