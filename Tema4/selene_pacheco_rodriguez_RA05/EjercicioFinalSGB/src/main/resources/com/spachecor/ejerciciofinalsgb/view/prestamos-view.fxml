<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #DDD0C8;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.spachecor.ejerciciofinalsgb.controller.PrestamosController">
    <children>
        <VBox prefHeight="720.0" prefWidth="340.0">
            <children>
                <VBox alignment="CENTER" prefHeight="50.0" prefWidth="340.0">
                    <children>
                        <Label text="Préstamos" textFill="#323232">
                            <font>
                                <Font name="Times New Roman Bold" size="36.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <VBox alignment="CENTER" prefHeight="670.0" prefWidth="340.0">
                    <children>
                        <HBox alignment="CENTER" prefHeight="50.0" prefWidth="340.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                                    <children>
                                        <Label text="ID" textFill="#323232">
                                            <font>
                                                <Font name="Times New Roman Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <children>
                                        <TextField fx:id="idTextField" promptText="Id del préstamo">
                                            <font>
                                                <Font name="Times New Roman" size="14.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                    <padding>
                                        <Insets right="20.0" />
                                    </padding>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="320.0" prefHeight="50.0" prefWidth="340.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                                    <children>
                                        <Label text="USUARIO" textFill="#323232">
                                            <font>
                                                <Font name="Times New Roman Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <padding>
                                        <Insets right="20.0" />
                                    </padding>
                           <children>
                              <ChoiceBox fx:id="usuarioChoiceBox" prefWidth="175.0" />
                           </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="295.0" prefHeight="50.0" prefWidth="340.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                                    <children>
                                        <Label text="LIBRO" textFill="#323232">
                                            <font>
                                                <Font name="Times New Roman Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <padding>
                                        <Insets right="20.0" />
                                    </padding>
                           <children>
                              <ChoiceBox fx:id="libroChoiceBox" prefWidth="175.0" />
                           </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="370.0" prefHeight="50.0" prefWidth="340.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                                    <children>
                                        <Label text="FECHA PRÉSTAMO" textFill="#323232">
                                            <font>
                                                <Font name="Times New Roman Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <padding>
                                        <Insets right="20.0" />
                                    </padding>
                           <children>
                              <DatePicker fx:id="fechaPrestamoDatePicker" promptText="Ej. 04/03/2025" />
                           </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="345.0" prefHeight="50.0" prefWidth="340.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                                    <children>
                                        <Label text="FECHA DEVOLUCIÓN" textAlignment="CENTER" textFill="#323232">
                                            <font>
                                                <Font name="Times New Roman Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <padding>
                                        <Insets right="20.0" />
                                    </padding>
                           <children>
                              <DatePicker fx:id="fechaDevolucionDatePicker" promptText="Ej. 11/03/2025" />
                           </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="370.0" prefHeight="50.0" prefWidth="340.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                                    <children>
                                        <Label text="DEVUELTO" textFill="#323232">
                                            <font>
                                                <Font name="Times New Roman Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <padding>
                                        <Insets right="20.0" />
                                    </padding>
                           <children>
                              <ChoiceBox fx:id="devueltoChoiceBox" prefWidth="175.0" />
                           </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="75.0" prefWidth="200.0" spacing="20.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onClickAniadirButton" style="-fx-background-color: #323232;" text="Añadir" textFill="#ddd0c8">
                                    <font>
                                        <Font name="Times New Roman Bold" size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding></Button>
                                <Button layoutX="142.0" layoutY="40.0" mnemonicParsing="false" onAction="#onClickModificarButton" style="-fx-background-color: #323232;" text="Modificar" textFill="#ddd0c8">
                                    <font>
                                        <Font name="Times New Roman Bold" size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Button>
                                <Button layoutX="104.0" layoutY="40.0" mnemonicParsing="false" onAction="#onClickEliminarButton" style="-fx-background-color: #323232;" text="Eliminar" textFill="#ddd0c8">
                                    <font>
                                        <Font name="Times New Roman Bold" size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Button>
                            </children>
                     <VBox.margin>
                        <Insets top="100.0" />
                     </VBox.margin>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="558.0" prefHeight="75.0" prefWidth="200.0" spacing="30.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onClickBuscarButton" style="-fx-background-color: #323232;" text="Buscar&#10;(Por ID)" textAlignment="CENTER" textFill="#ddd0c8">
                                    <font>
                                        <Font name="Times New Roman Bold" size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Button>
                                <Button layoutX="104.0" layoutY="40.0" mnemonicParsing="false" onAction="#onClickListarButton" style="-fx-background-color: #323232;" text="Listar" textFill="#ddd0c8">
                                    <font>
                                        <Font name="Times New Roman Bold" size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Button>
                                <Button layoutX="194.0" layoutY="28.0" mnemonicParsing="false" onAction="#onClickSalirButton" style="-fx-background-color: #323232;" text="Salir" textFill="#ddd0c8">
                                    <font>
                                        <Font name="Times New Roman Bold" size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                    </children></VBox>
            </children></VBox>
        <VBox prefHeight="720.0" prefWidth="940.0">
            <children>
                <TableView fx:id="prestamoTableView" onMouseClicked="#onClickPrestamosTableView" prefHeight="720.0" prefWidth="940.0">
                    <columns>
                        <TableColumn fx:id="idTableColumn" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="usuarioTableColumn" prefWidth="250.0" text="USUARIO" />
                        <TableColumn fx:id="libroTableColumn" prefWidth="175.0" text="LIBRO" />
                        <TableColumn fx:id="fechaPrestamoTableColumn" prefWidth="175.0" text="FECHA DE PRÉSTAMO" />
                        <TableColumn fx:id="fechaDevolucionTableColumn" prefWidth="175.0" text="FECHA DE DEVOLUCIÓN" />
                        <TableColumn fx:id="devueltoTableColumn" prefWidth="100.0" text="DEVUELTO" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>
