<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #DDD0C8;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.spachecor.ejerciciofinalsgb.controller.ColeccionesController">
   <children>
      <VBox alignment="CENTER" prefHeight="720.0" prefWidth="640.0" spacing="25.0">
         <children>
            <Label text="Colecciones" textFill="#323232">
               <VBox.margin>
                  <Insets bottom="50.0" />
               </VBox.margin>
               <font>
                  <Font name="Times New Roman Bold" size="36.0" />
               </font></Label>
            <TextField fx:id="nombreTextField" maxWidth="250.0" promptText="Nombre de la categoría">
               <font>
                  <Font name="Times New Roman" size="18.0" />
               </font></TextField>
            <Button mnemonicParsing="false" onAction="#onClickModificarButton" style="-fx-background-color: #323232;" text="Modificar" textFill="#ddd0c8">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="50.0" />
               </VBox.margin>
            </Button>
            <Button layoutX="263.0" layoutY="373.0" mnemonicParsing="false" onAction="#onClickEliminarButton" style="-fx-background-color: #323232;" text="Eliminar" textFill="#ddd0c8">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="100.0" />
               </VBox.margin>
            </Button>
            <Button layoutX="263.0" layoutY="408.0" mnemonicParsing="false" onAction="#onClickSalirButton" style="-fx-background-color: #323232;" text="Salir" textFill="#ddd0c8">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
            </Button>
         </children></VBox>
      <VBox prefHeight="720.0" prefWidth="640.0">
         <children>
            <TableView fx:id="coleccionesTableView" prefHeight="360.0" prefWidth="640.0">
              <columns>
                <TableColumn fx:id="coleccionesTableColumn" maxWidth="640.0" prefWidth="640.0" resizable="false" style="-fx-alignment: CENTER;" text="COLECCIONES" />
              </columns>
            </TableView>
            <TableView fx:id="subColeccionesTableView" onMouseClicked="#onClickSubColeccionesTableView" prefHeight="360.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="subColeccionesTableColumn" maxWidth="640.0" prefWidth="640.0" resizable="false" style="-fx-alignment: CENTER;" text="SUBCOLECCIONES (CATEGORIAS DE LOS LIBROS)" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</HBox>
