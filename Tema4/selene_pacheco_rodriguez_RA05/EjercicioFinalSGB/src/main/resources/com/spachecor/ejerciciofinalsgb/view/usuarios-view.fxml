                                        <Font name="Times New Roman Bold" size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Button>
                                <Button layoutX="194.0" layoutY="28.0" mnemonicParsing="false" onAction="#onClickSalirButton" style="-fx-background-color: #323232;" text="Salir" textFill="#ddd0c8">
