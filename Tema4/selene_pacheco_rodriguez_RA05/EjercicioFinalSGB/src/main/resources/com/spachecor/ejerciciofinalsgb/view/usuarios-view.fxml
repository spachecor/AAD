                        <TableColumn fx:id="idTableColumn" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="dniTableColumn" prefWidth="150.0" text="DNI" />
                        <TableColumn fx:id="nombreTableColumn" prefWidth="150.0" text="NOMBRE" />
                        <TableColumn fx:id="emailTableColumn" prefWidth="150.0" text="EMAIL" />
                        <TableColumn fx:id="telefonoTableColumn" prefWidth="150.0" text="TELÉFONO" />
                        <TableColumn fx:id="direccionTableColumn" prefWidth="275.0" text="DIRECCIÓN" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
