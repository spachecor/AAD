                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <children>
                                        <TextField fx:id="nombreTextField" promptText="Nombre del usuario">
                                            <font>
                                                <Font name="Times New Roman" size="14.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                    <padding>
                                        <Insets right="20.0" />
                                    </padding>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" layoutX="10.0" layoutY="370.0" prefHeight="50.0" prefWidth="340.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
