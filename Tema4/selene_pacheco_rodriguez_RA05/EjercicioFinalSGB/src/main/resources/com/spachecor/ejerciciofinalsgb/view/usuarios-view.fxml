                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="190.0">
                                    <children>
                                        <TextField fx:id="dniTextField" promptText="DNI del usuario">
                                            <font>
                                                <Font name="Times New Roman" size="14.0" />
