                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Button>
                                <Button layoutX="104.0" layoutY="40.0" mnemonicParsing="false" onAction="#onClickEliminarButton" style="-fx-background-color: #323232;" text="Eliminar" textFill="#ddd0c8">
