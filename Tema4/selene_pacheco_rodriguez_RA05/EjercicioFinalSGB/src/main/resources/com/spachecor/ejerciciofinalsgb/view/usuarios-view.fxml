<HBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #DDD0C8;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.spachecor.ejerciciofinalsgb.controller.UsuariosController">
    <children>
        <VBox prefHeight="720.0" prefWidth="340.0">
